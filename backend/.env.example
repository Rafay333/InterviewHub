# Server
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- SQL Server (Windows Authentication — matches SSMS) ---
# Example SSMS server: ARAFAY-IT\ABDULRAFAY  → use double backslash in .env
DB_SERVER=ARAFAY-IT\\ABDULRAFAY
DB_DATABASE=InterviewHub
DB_TRUSTED_CONNECTION=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Or SQL Authentication (sa + password) ---
# DB_TRUSTED_CONNECTION=false
# DB_USER=sa
# DB_PASSWORD=YourPassword
# DB_PORT=1433

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

ADMIN_SEED_EMAIL=admin@interviewhub.com
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=Founder Admin
