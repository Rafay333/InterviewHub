# Server
# On Railway, do not set PORT yourself — Railway assigns it.
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Railway PostgreSQL (public URL from Settings → Networking)
# DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

ADMIN_SEED_EMAIL=admin@interviewhub.com
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=Founder Admin
